# ── Платформы ───────────────────────────────────────────────────────────────
# Пока нет токена MAX, оставьте только telegram. Когда токен появится:
# ENABLED_PLATFORMS=telegram,max  и перезапустите: docker compose up -d
ENABLED_PLATFORMS=telegram

# Токен от @BotFather
BOT_TOKEN_TELEGRAM=
# Токен из кабинета разработчика на dev.max.ru (выдаётся верифицированной организации)
# Адрес API MAX. Менять нужно только если MAX починит platform-api2.max.ru:
# сейчас тот хост не отвечает, поэтому по умолчанию ходим на platform-api.max.ru.
MAX_API_URL=https://platform-api.max.ru
BOT_TOKEN_MAX=

# ── Админы ──────────────────────────────────────────────────────────────────
# Только числовые id через запятую. Свой id человек узнаёт командой /whoami в боте.
# Username здесь не работает: по нему Bot API не умеет писать в личку, поэтому права
# были бы, а уведомления молча не доходили бы. Нечисловые записи бот пропускает
# и пишет об этом в лог при старте.
ADMIN_IDS_TELEGRAM=
ADMIN_IDS_MAX=

# ── Кампания ────────────────────────────────────────────────────────────────
CAMPAIGN_START_DATE=2026-09-01
CAMPAIGN_DAYS=40
BROADCAST_TIME=07:00
# Сообщений в секунду на платформу. Лимит платформ около 30, 20 берём с запасом.
BROADCAST_RATE=20
TIMEZONE=Europe/Moscow

# Сколько дней хранить историю заявок. 90 это примерно три месяца.
# Удаляются только закрытые заявки: открытые не трогаются никогда, каким бы старым
# ни было обращение, иначе можно потерять человека, которому забыли позвонить.
REQUESTS_RETENTION_DAYS=90

# ── Тексты и даты, которые церковь меняет под себя ──────────────────────────
CAMPAIGN_TITLE=40 ДНЕЙ МОЛИТВЫ
# Когда участники получают набор (звучит в подтверждении регистрации и в статусе).
KIT_DATE=1 ноября
# До какой даты координатор связывается с теми, кто ждёт направления в малую группу.
MDG_DEADLINE=25 октября
# За какой срок служитель отвечает на вопрос из бота.
REPLY_TIME=в течение трёх дней

# Документы об обработке персональных данных: бот показывает их перед сбором данных.
POLICY_TERMS_URL=https://mbv.spb.ru/wp-content/uploads/2020/01/Polozhenie-ob-obrabotke-per.dannyh-MBV.pdf
POLICY_URL=https://mbv.spb.ru/wp-content/uploads/2020/01/Politika-obrabotke-per.dannyh-MBV.pdf

# ── Варианты ответа «Какую церковь вы посещаете?» ───────────────────────────
# Через точку с запятой, по порядку. «Другая церковь» и «Не посещаю церковь»
# бот добавляет сам. Меняются без правки кода: допишите строку и перезапустите.
CHURCH_BRANCHES=МБВ Колизей;МБВ Филиалы;МБВ онлайн
# Второй экран: показывается выбравшим «Другая церковь». Пункт «Другая» бот
# добавляет сам. Названия «Созвездие» и «Миссия Свет Христа» в правках стояли
# под вопросом — поправьте здесь, когда уточните.
OTHER_CHURCHES=Церковь «Иисуса Христа» г. Кингисепп;Церковь «Созвездие»;Церковь «Миссия Свет Христа»

# ── Обход блокировки Telegram (нужен на российских хостингах) ───────────────
# DNS может отдавать адрес api.telegram.org, который не отвечает. Здесь задаётся
# живой IP, к которому compose прибивает имя хоста. Проверить и найти рабочий:
#   for ip in 149.154.167.220 149.154.166.110 149.154.175.50 91.108.56.130; do
#     curl -s -o /dev/null -m 8 --resolve api.telegram.org:443:$ip \
#       https://api.telegram.org -w "$ip -> %{http_code}\n"; done
# Годится тот, что отвечает не 000. На машинах без блокировки строку можно не трогать.
TELEGRAM_API_IP=149.154.167.220

# ── База данных ─────────────────────────────────────────────────────────────
POSTGRES_USER=church
POSTGRES_PASSWORD=changeme
POSTGRES_DB=church40
# В docker compose DATABASE_URL подставляется автоматически.
# Для локального npm run dev раскомментируйте строку ниже (порт 5433 из docker-compose.dev.yml):
# DATABASE_URL=postgres://church:changeme@localhost:5433/church40

# ── Только для тестов ───────────────────────────────────────────────────────
# Добавляет служителям кнопку «🧹 Очистить базу»: удаляет участников, заявки,
# материалы дней и журнал рассылок. Перед реальной кампанией поставьте false,
# и кнопка исчезнет из меню совсем.
ALLOW_DB_RESET=false

# ── Дашборд статистики ──────────────────────────────────────────────────────
# Пароль на вход. Не короче 8 символов; сессия живёт DASHBOARD_SESSION_DAYS дней.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8090
DASHBOARD_SESSION_DAYS=7
# Ставьте false, только если открываете дашборд по http (без TLS) при локальной отладке.
DASHBOARD_COOKIE_SECURE=true

LOG_LEVEL=info
