  "version": "0.1.0",
  "type": "module",
  "description": "Интерфейс сервиса «Домашние группы» (этап A: только чтение)",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "VITE_FIXTURES=1 vite",
